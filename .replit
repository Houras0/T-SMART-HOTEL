modules = ["nodejs-24"]
run = "pnpm --filter @workspace/api-server run dev"

[deployment]
run = "pnpm --filter @workspace/api-server run start"

[agent]
expertMode = true

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 26006
externalPort = 3001

[nix]
channel = "stable-25_05"
packages = ["psmisc"]
